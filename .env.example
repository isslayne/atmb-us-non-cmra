# Examples only. The application reads process environment variables; source this file explicitly.
SMARTY_AUTH_ID=replace-with-auth-id
SMARTY_AUTH_TOKEN=replace-with-auth-token
# Optional multiple accounts; takes precedence over the pair above:
# CREDENTIALS=id1=token1,id2=token2
ADDRESS_SCOPE=tax-free
USPS_ENABLED=true
# Install with: npm ci && npx playwright install chrome
USPS_BACKEND=browser
USPS_CHANNEL=chrome
USPS_HEADLESS=false
USPS_INTERVAL_MS=1000
MAX_ADDRESSES=0

# Optional HTTP/HTTPS proxy for USPS; do not commit real credentials.
# USPS_PROXY=http://proxy-host:port
